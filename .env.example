# Names only, no values. Copy to .env and fill in; .env is git-ignored.
# The default (env) adapter reads these; a project with its own adapter.ts may read its secrets from elsewhere.
PERF_TOKEN_URL=
PERF_TOKEN_CLIENT_ID=
PERF_SCOPE=
# One pair per role listed in the project's project.yaml `roles`, upper-cased:
# for `roles: [Analyst, Manager]` set PERF_ANALYST_LOGIN / PERF_ANALYST_PASSWORD and PERF_MANAGER_LOGIN / PERF_MANAGER_PASSWORD.
PERF_ANALYST_LOGIN=
PERF_ANALYST_PASSWORD=
PERF_MANAGER_LOGIN=
PERF_MANAGER_PASSWORD=
